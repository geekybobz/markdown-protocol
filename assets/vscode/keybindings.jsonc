[
  // Merge this entry into User keybindings.json after making a backup.
  {
    "key": "ctrl+alt+v",
    "mac": "cmd+alt+v",
    "command": "markdown-preview-enhanced.openPreviewToTheSide",
    "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
  },

  // Optional companion entries when LaTeX Workshop is already installed.
  {
    "key": "ctrl+alt+v",
    "mac": "cmd+alt+v",
    "command": "latex-workshop.view",
    "when": "resourceExtname == '.tex'"
  },
  {
    "key": "ctrl+alt+j",
    "mac": "cmd+alt+j",
    "command": "latex-workshop.synctex",
    "when": "resourceExtname == '.tex' && editorTextFocus"
  }
]
